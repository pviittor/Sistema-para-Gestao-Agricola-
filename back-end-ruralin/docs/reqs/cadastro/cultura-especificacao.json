{
  "table": {
    "name": "C009_cultura",
    "singularName": "Cultura",
    "pluralName": "Culturas",
    "description": "Culturas do sistema",
    "multiTenant": true,
    "auditable": true,
    "cacheable": true
  },
  "fields": [
    {
      "name": "id",
      "type": "INTEGER",
      "required": true,
      "unique": true,
      "excludeFromCreate": true,
      "excludeFromUpdate": true,
      "comment": "ID único da cultura (auto-increment)"
    },
    {
      "name": "tenantId",
      "type": "INTEGER",
      "required": true,
      "excludeFromCreate": true,
      "excludeFromUpdate": true,
      "excludeFromResponse": false,
      "comment": "ID do tenant ao qual a cultura pertence"
    },
    {
      "name": "descricao_clt",
      "type": "STRING",
      "required": true,
      "comment": "Descrição da cultura",
      "validation": {
        "min": 3,
        "max": 255
      }
    },
    {
      "name": "idProduto",
      "type": "INTEGER",
      "required": true,
      "comment": "ID do produto relacionado",
      "validation": {
        "custom": "IsExists:Produto,id_prod"
      }
    },
    {
      "name": "usercreation",
      "type": "INTEGER",
      "required": true,
      "excludeFromCreate": true,
      "excludeFromUpdate": true,
      "comment": "ID do usuário que criou o registro"
    },
    {
      "name": "datecreation",
      "type": "DATE",
      "required": true,
      "excludeFromCreate": true,
      "excludeFromUpdate": true,
      "comment": "Data de criação do registro"
    }
  ],
  "relationships": [
    {
      "type": "belongsTo",
      "target": "Usuario",
      "foreignKey": "usercreation",
      "as": "usuarioCriador",
      "required": true,
      "onDelete": "RESTRICT",
      "comment": "Cultura foi criada por um usuário"
    },
    {
      "type": "belongsTo",
      "target": "Produto",
      "foreignKey": "idProduto",
      "as": "produto",
      "required": true,
      "onDelete": "RESTRICT",
      "comment": "Cultura pertence a um produto"
    }
  ],
  "permissions": {
    "create": "cultura.create",
    "read": "cultura.read",
    "update": "cultura.update",
    "delete": "cultura.delete"
  },
  "cache": {
    "enabled": true,
    "ttl": 3600,
    "keys": [
      "cultura:list:*",
      "cultura:findById:*",
      "cultura:findByProduto:*"
    ]
  },
  "businessRules": [
    {
      "type": "crossTenant",
      "description": "Validar se Produto pertence ao mesmo tenant da Cultura",
      "implementation": "No método create() e update() do Application Service, verificar se o Produto pertence ao mesmo tenant antes de salvar. Lançar ForbiddenException se não pertencer ao mesmo tenant."
    }
  ],
  "customMethods": [
    {
      "name": "findByProduto",
      "type": "repository",
      "description": "Busca todas as culturas de um produto específico",
      "parameters": [
        {
          "name": "idProduto",
          "type": "number",
          "required": true,
          "description": "ID do produto"
        }
      ],
      "returnType": "Cultura[]",
      "cacheKey": "cultura:findByProduto:{idProduto}"
    }
  ]
}
