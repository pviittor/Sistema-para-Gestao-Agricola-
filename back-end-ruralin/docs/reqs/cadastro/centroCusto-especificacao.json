{
  "table": {
    "name": "C016_centroCusto",
    "singularName": "CentroCusto",
    "pluralName": "CentroCustos",
    "description": "Centros de custo com hierarquia",
    "multiTenant": true,
    "auditable": true,
    "cacheable": true
  },
  "fields": [
    {
      "name": "id",
      "type": "INTEGER",
      "required": true,
      "unique": true,
      "excludeFromCreate": true,
      "excludeFromUpdate": true,
      "comment": "ID único do centro de custo (auto-increment)"
    },
    {
      "name": "tenantId",
      "type": "INTEGER",
      "required": true,
      "excludeFromCreate": true,
      "excludeFromUpdate": true,
      "excludeFromResponse": false,
      "comment": "ID do tenant ao qual o centro de custo pertence"
    },
    {
      "name": "codigo",
      "type": "STRING",
      "required": true,
      "unique": true,
      "comment": "Código do centro de custo",
      "validation": {
        "min": 2,
        "max": 50
      }
    },
    {
      "name": "nome",
      "type": "STRING",
      "required": true,
      "comment": "Nome do centro de custo",
      "validation": {
        "min": 3,
        "max": 255
      }
    },
    {
      "name": "centroCustoPaiId",
      "type": "INTEGER",
      "required": false,
      "comment": "ID do centro de custo pai (para hierarquia). NULL para centros de custo de primeiro nível",
      "validation": {
        "custom": "IsExists:CentroCusto,id"
      }
    },
    {
      "name": "ativo",
      "type": "BOOLEAN",
      "required": false,
      "defaultValue": true,
      "comment": "Se o centro de custo está ativo"
    },
    {
      "name": "usercreation",
      "type": "INTEGER",
      "required": true,
      "excludeFromCreate": true,
      "excludeFromUpdate": true,
      "comment": "ID do usuário que criou o registro"
    },
    {
      "name": "datecreation",
      "type": "DATE",
      "required": true,
      "excludeFromCreate": true,
      "excludeFromUpdate": true,
      "comment": "Data de criação do registro"
    }
  ],
  "relationships": [
    {
      "type": "belongsTo",
      "target": "Usuario",
      "foreignKey": "usercreation",
      "as": "usuarioCriador",
      "required": true,
      "onDelete": "RESTRICT",
      "comment": "Centro de custo foi criado por um usuário"
    },
    {
      "type": "belongsTo",
      "target": "CentroCusto",
      "foreignKey": "centroCustoPaiId",
      "as": "centroCustoPai",
      "required": false,
      "onDelete": "SET NULL",
      "comment": "Centro de custo pai na hierarquia"
    },
    {
      "type": "hasMany",
      "target": "CentroCusto",
      "foreignKey": "centroCustoPaiId",
      "as": "centrosCustoFilhos",
      "comment": "Centros de custo filhos na hierarquia"
    }
  ],
  "permissions": {
    "create": "centroCusto.create",
    "read": "centroCusto.read",
    "update": "centroCusto.update",
    "delete": "centroCusto.delete"
  },
  "cache": {
    "enabled": true,
    "ttl": 3600,
    "keys": [
      "centroCusto:list:*",
      "centroCusto:findById:*",
      "centroCusto:findByPai:*"
    ]
  },
  "businessRules": [
    {
      "type": "crossTenant",
      "description": "Validar se centroCustoPai pertence ao mesmo tenant",
      "implementation": "No método create() e update() do Application Service, verificar se o centroCustoPai pertence ao mesmo tenant antes de salvar. Lançar ForbiddenException se não pertencer ao mesmo tenant."
    },
    {
      "type": "validation",
      "description": "Evitar referência circular na hierarquia",
      "implementation": "Validar no Application Service que centroCustoPaiId não cria ciclo. Se centroCustoPaiId for fornecido, verificar recursivamente que o pai não é descendente do centro de custo atual."
    }
  ],
  "customMethods": [
    {
      "name": "findByPai",
      "type": "repository",
      "description": "Busca centros de custo filhos de um pai específico",
      "parameters": [
        {
          "name": "centroCustoPaiId",
          "type": "number",
          "required": true,
          "description": "ID do centro de custo pai"
        }
      ],
      "returnType": "CentroCusto[]",
      "cacheKey": "centroCusto:findByPai:{centroCustoPaiId}"
    }
  ]
}
